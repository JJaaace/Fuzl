{
  "name": "fuzl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @fuzl/web",
    "dev:api": "npm run dev --workspace @fuzl/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test apps/web/src/lib/api.test.ts",
    "build": "npm run build --workspaces",
    "start:api": "npm run start --workspace @fuzl/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
