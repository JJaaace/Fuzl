# Copy to apps/api/.env. This file is loaded only by the backend commands.
PORT=3001
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Only the selected provider's key is required. No automatic provider fallback.
# For Gemini: verify this key's project is Free Tier and check its model quotas
# in Google AI Studio before enabling. Do not enable billing for free testing.
# Use synthetic conversations only; unpaid Google content may be reviewed/used
# to improve products. For OpenAI, review the development project budget first.
AI_ENABLED=false
# Models: OpenAI gpt-5.4-mini-2026-03-17 / Gemini gemini-3.5-flash-lite.
# Neither Fuzl nor this setting verifies a project's billing tier.
# AI keys and database credentials stay backend-only; no VITE_ secrets.
# Local guard: at most 10 attempts per API process, 3/minute, 1 in flight.

# Optional Section 5 saving: one Supabase project for Auth + PostgreSQL.
# Public project URL and sb_publishable_ key are served to the browser explicitly.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# PRIVATE database connection (Session pooler, port 5432, TLS). Never VITE_.
# Use sslmode=verify-full and sslrootcert=/absolute/path/to/downloaded-ca.crt.
# The Prisma CLI config translates these to its own strict TLS parameters.
DATABASE_URL=
# Optional PRIVATE migration connection, same project/password/CA. Prisma uses
# this in preference to DATABASE_URL; the API continues using DATABASE_URL.
# Direct endpoint: db.PROJECT_REF.supabase.co:5432, user postgres; IPv6 required
# unless the project already has IPv4 support. Do not enable a paid IPv4 add-on.
# Locally used because macOS rejects the session pooler's legacy certificate.
DIRECT_URL=
# Canonical local magic-link origin; use 127.0.0.1 in the browser too.
# Supabase redirect allowlist: http://127.0.0.1:5173/auth/callback (no wildcard).
APP_ORIGIN=http://127.0.0.1:5173
