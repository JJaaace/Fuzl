{
  "name": "@fuzl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ../../scripts/check-api-port.mjs && tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "eval:live": "tsx --env-file-if-exists=.env src/extraction/evaluate.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env ../../scripts/check-storage.mjs && prisma migrate deploy",
    "db:status": "node --env-file-if-exists=.env ../../scripts/check-storage.mjs && prisma migrate status",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate"
  },
  "dependencies": {
    "@fuzl/planning": "0.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.119.0",
    "dotenv": "17.3.1",
    "express": "5.3.0",
    "openai": "7.53.0",
    "pg": "8.16.3",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.16.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
