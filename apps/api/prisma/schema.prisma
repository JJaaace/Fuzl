generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
  schemas = ["fuzl"]
}
model Organizer {
  id String @id @default(uuid()) @db.Uuid
  authSubject String @unique @db.Uuid
  createdAt DateTime @default(now())
  groups Group[]
  @@schema("fuzl")
  @@map("fuzl_organizers")
}
model Group {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner Organizer @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aliases ParticipantAlias[]
  sessions PlanningSession[]
  outings Outing[]
  ideas SavedIdea[]
  @@index([ownerId])
  @@schema("fuzl")
  @@map("fuzl_groups")
}
model ParticipantAlias {
  id String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([groupId])
  @@schema("fuzl")
  @@map("fuzl_aliases")
}
model PlanningSession {
  id String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title String @db.VarChar(100)
  invites GuestInvite[]
  shortlist BallotShortlist?
  ballots Ballot[]
  plan SharedPlan?
  summaryVersion Int @default(1)
  summary Json
  provenance Json
  origin String @db.VarChar(10)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([groupId])
  @@schema("fuzl")
  @@map("fuzl_sessions")
}

model GuestInvite {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  session PlanningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activeSessionId String? @unique @db.Uuid
  tokenDigest String @unique @db.VarChar(64)
  title String @db.VarChar(100)
  questions Json
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  responses GuestResponse[]
  @@index([sessionId])
  @@schema("fuzl")
  @@map("fuzl_guest_invites")
}
model GuestResponse {
  id String @id @default(uuid()) @db.Uuid
  inviteId String @db.Uuid
  invite GuestInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  submissionId String @db.Uuid
  editDigest String @unique @db.VarChar(64)
  alias String @db.VarChar(80)
  answers Json
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  privateAnswers GuestPrivateAnswer[]
  @@unique([inviteId, submissionId])
  @@index([inviteId])
  @@schema("fuzl")
  @@map("fuzl_guest_responses")
}
model GuestPrivateAnswer {
  id String @id @default(uuid()) @db.Uuid
  responseId String @db.Uuid
  response GuestResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String @db.Uuid
  amount Decimal? @db.Decimal(12,2)
  currency String? @db.VarChar(3)
  state String @db.VarChar(10)
  @@unique([responseId, questionId])
  @@schema("fuzl")
  @@map("fuzl_guest_private_answers")
}

model BallotShortlist {
  sessionId String @id @db.Uuid
  session PlanningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content Json
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  @@schema("fuzl")
  @@map("fuzl_ballot_shortlists")
}
model Ballot {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  session PlanningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currentSessionId String? @unique @db.Uuid
  publicationId String @db.Uuid
  version Int
  revision Int @default(1)
  tokenDigest String @unique @db.VarChar(64)
  content Json
  expiresAt DateTime
  closedAt DateTime?
  revokedAt DateTime?
  supersededByVersion Int?
  createdAt DateTime @default(now())
  votes BallotVote[]
  @@unique([sessionId, version])
  @@unique([sessionId, publicationId])
  @@index([sessionId])
  @@schema("fuzl")
  @@map("fuzl_ballots")
}
model BallotVote {
  id String @id @default(uuid()) @db.Uuid
  ballotId String @db.Uuid
  ballot Ballot @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  submissionId String @db.Uuid
  editDigest String @unique @db.VarChar(64)
  optionId String @db.Uuid
  revision Int @default(1)
  lastRequestId String? @db.Uuid
  updatedAt DateTime @updatedAt
  @@unique([ballotId, submissionId])
  @@index([ballotId])
  @@schema("fuzl")
  @@map("fuzl_ballot_votes")
}

model SharedPlan {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @unique @db.Uuid
  session PlanningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  draft Json
  status String @default("proposed") @db.VarChar(12)
  revision Int @default(1)
  publishedVersion Int @default(0)
  materialVersion Int @default(0)
  rsvpsClosed Boolean @default(false)
  lastRequestId String @db.Uuid
  lastRequestHash String @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions PlanVersion[]
  links PlanLink[]
  rsvps PlanRsvp[]
  outing Outing?
  @@schema("fuzl")
  @@map("fuzl_shared_plans")
}
model PlanVersion {
  id String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid
  plan SharedPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version Int
  materialVersion Int
  snapshot Json
  status String @db.VarChar(12)
  changeNotice String @db.VarChar(500)
  createdAt DateTime @default(now())
  @@unique([planId, version])
  @@schema("fuzl")
  @@map("fuzl_plan_versions")
}
model PlanLink {
  id String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid
  plan SharedPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  activePlanId String? @unique @db.Uuid
  tokenDigest String @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([planId])
  @@schema("fuzl")
  @@map("fuzl_plan_links")
}
model PlanRsvp {
  id String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid
  plan SharedPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  submissionId String @db.Uuid
  editDigest String @unique @db.VarChar(64)
  alias String @db.VarChar(80)
  choice String @db.VarChar(8)
  answeredMaterialVersion Int
  revision Int @default(1)
  lastRequestId String? @db.Uuid
  updatedAt DateTime @updatedAt
  @@unique([planId, submissionId])
  @@index([planId])
  @@schema("fuzl")
  @@map("fuzl_plan_rsvps")
}

model Outing {
  id String @id @default(uuid()) @db.Uuid
  planId String @unique @db.Uuid
  plan SharedPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  groupId String @db.Uuid
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  original Json
  originalVersion Int
  actual Json
  actualVersion Int @default(1)
  sameListing Boolean @default(false)
  confirmedAttendees Json
  revision Int @default(1)
  feedbackVersion Int @default(0)
  privateNotes String @default("") @db.VarChar(1000)
  proposedTakeaway String @default("") @db.VarChar(300)
  approvedTakeaway String? @db.VarChar(300)
  approvedFeedbackVersion Int?
  lastRequestId String @db.Uuid
  lastRequestHash String @db.VarChar(64)
  createdAt DateTime @default(now())
  feedback OutingFeedback[]
  @@index([groupId])
  @@schema("fuzl")
  @@map("fuzl_outings")
}
model OutingFeedback {
  id String @id @default(uuid()) @db.Uuid
  outingId String @db.Uuid
  outing Outing @relation(fields: [outingId], references: [id], onDelete: Cascade)
  submissionId String @db.Uuid
  editDigest String @db.VarChar(64)
  answers Json
  memoryOpinion Json
  actualVersion Int @default(1)
  revision Int @default(1)
  lastRequestId String? @db.Uuid
  lastRequestHash String? @db.VarChar(64)
  updatedAt DateTime @updatedAt
  @@unique([outingId, submissionId])
  @@unique([outingId, editDigest])
  @@schema("fuzl")
  @@map("fuzl_outing_feedback")
}

model SavedIdea {
  id String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  content Json
  origin Json
  archived Boolean @default(false)
  edited Boolean @default(false)
  revision Int @default(1)
  creationId String @db.Uuid
  creationHash String @db.VarChar(64)
  lastRequestId String @db.Uuid
  lastRequestHash String @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([groupId, creationId])
  @@index([groupId])
  @@schema("fuzl")
  @@map("fuzl_saved_ideas")
}
