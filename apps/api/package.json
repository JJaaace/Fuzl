{
  "name": "@fuzl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ../../scripts/check-api-port.mjs && tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "eval:live": "tsx --env-file-if-exists=.env src/extraction/evaluate.ts"
  },
  "dependencies": {
    "@fuzl/planning": "0.1.0",
    "express": "5.3.0",
    "openai": "7.53.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "tsx": "4.23.15"
  }
}
