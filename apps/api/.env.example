# Copy to apps/api/.env. This file is loaded only by the backend commands.
PORT=3001
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Only the selected provider's key is required. No automatic provider fallback.
# For Gemini: verify this key's project is Free Tier and check its model quotas
# in Google AI Studio before enabling. Do not enable billing for free testing.
# Use synthetic conversations only; unpaid Google content may be reviewed/used
# to improve products. For OpenAI, review the development project budget first.
AI_ENABLED=false
# Models: OpenAI gpt-5.4-mini-2026-03-17 / Gemini gemini-3.5-flash-lite.
# Neither Fuzl nor this setting verifies a project's billing tier.
# No frontend credentials or VITE_ secrets.
# Local guard: at most 10 attempts per API process, 3/minute, 1 in flight.
